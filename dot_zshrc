export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="headline"

plugins=(
  git
  sudo
  extract
  colored-man-pages
  docker docker-compose
  ansible terraform kubectl
  fzf
  zsh-autosuggestions
  zsh-syntax-highlighting
  history-substring-search
)

source $ZSH/oh-my-zsh.sh

# Syntax highlighting: valid commands in cyan
ZSH_HIGHLIGHT_STYLES[command]='fg=cyan'
ZSH_HIGHLIGHT_STYLES[builtin]='fg=cyan'
ZSH_HIGHLIGHT_STYLES[alias]='fg=cyan'
ZSH_HIGHLIGHT_STYLES[function]='fg=cyan'
ZSH_HIGHLIGHT_STYLES[precommand]='fg=cyan,underline'
ZSH_HIGHLIGHT_STYLES[unknown-token]='fg=#bd93f9,bold'

# Headline prompt: pink palette (same as tmux) - must stay after oh-my-zsh.sh
hl_pink=$'\e[38;2;255;143;199m'
hl_lilac=$'\e[38;2;216;167;245m'
hl_rose=$'\e[38;2;255;179;217m'
hl_plum=$'\e[38;2;155;107;176m'

HL_CONTENT_TEMPLATE[USER]="%{$bold$hl_pink%}..."
HL_CONTENT_TEMPLATE[HOST]="%{$bold$hl_lilac%}..."
HL_CONTENT_TEMPLATE[PATH]="%{$bold$hl_rose%}..."
HL_CONTENT_TEMPLATE[BRANCH]="%{$bold$hl_lilac%}..."
HL_CONTENT_TEMPLATE[STATUS]="%{$bold$hl_pink%}..."
HL_SEP_STYLE="%{$hl_plum%}"
HL_LAYOUT_STYLE="%{$hl_plum%}"

export PATH="$HOME/.local/bin:$PATH"

HISTSIZE=10000
SAVEHIST=10000
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_IGNORE_SPACE HIST_VERIFY

setopt AUTO_CD
setopt CORRECT
setopt INTERACTIVE_COMMENTS
bindkey -e
bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

zstyle ':completion:*' matcher-list 'm:{a-z}={A-Z}'
zstyle ':completion:*' menu select

command -v eza >/dev/null && alias ls='eza --icons --group-directories-first' && alias ll='eza -la --icons --git'
command -v bat >/dev/null && alias cat='bat --paging=never'
alias zshrc='chezmoi edit --apply ~/.zshrc && source ~/.zshrc'

virip() {
  sudo iptables -I FORWARD -i virbr0 -j ACCEPT
  sudo iptables -I FORWARD -o virbr0 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
  sudo iptables -I FORWARD -i virbr1 -j ACCEPT
  sudo iptables -I FORWARD -o virbr1 -m conntrack --ctstate RELATED,ESTABLISHED -j ACCEPT
  echo "virbr0 accepted"
  echo "virbr1 accepted"
}

[[ -n $TMUX ]] && export COLORTERM=truecolor
PROMPT_EOL_MARK=''

