
{{ if eq .chezmoi.osRelease.id "fedora" -}}
#!/bin/bash
# Liste : {{ .packages.fedora | join " " }}
sudo dnf install -y {{ range .packages.fedora }}{{ . | quote }} {{ end }}
{{ else if eq .chezmoi.osRelease.id "debian" -}}
#!/bin/bash
# Liste : {{ .packages.debian | join " " }}
sudo apt-get update
sudo apt-get install -y {{ range .packages.debian }}{{ . | quote }} {{ end }}
{{ end -}}
